# ──────────────────────────────────────────────────────────────
# GitScout server config (copy to server/.env)
# ──────────────────────────────────────────────────────────────

# Optional. Without a token, Octokit hits GitHub's anonymous rate
# limit (60 req/hr). A classic PAT with `public_repo` scope raises
# this to 5000 req/hr. See: https://github.com/settings/tokens
GITHUB_TOKEN=

# Frontend origin allowed through CORS. Defaults to the Next.js
# dev server if unset.
CORS_ORIGIN=http://localhost:3000

# SQLite file path. Defaults to ./gitscout.db relative to the
# server working directory. Use ":memory:" for ephemeral dev.
DATABASE_URL=./gitscout.db
